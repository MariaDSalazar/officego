{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfficeGo",
  "version": "2.0.0",
  "identifier": "dev.officego.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "OfficeGo",
        "width": 1016,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "copyright": "MIT · Diego Fernando Loján Tenesaca y María del Carmen Salazar Torres",
    "shortDescription": "Instalador y activador de Microsoft Office",
    "longDescription": "Instala Microsoft Office descargándolo de los servidores oficiales de Microsoft. Seis versiones con sus ediciones, recomendación según el equipo y activación integrada.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
